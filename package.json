{
  "name": "@sencorp/react-ui",
  "version": "0.1.8",
  "description": "React UI components from Sencorp, organized by component family.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JS00001/react-ui.git"
  },
  "type": "module",
  "exports": {
    "./table": {
      "import": {
        "types": "./dist/table/index.d.ts",
        "default": "./dist/table/index.js"
      },
      "require": {
        "types": "./dist/table/index.d.cts",
        "default": "./dist/table/index.cjs"
      }
    },
    "./table/styles.css": "./dist/table/index.css",
    "./modal": {
      "import": {
        "types": "./dist/modal/index.d.ts",
        "default": "./dist/modal/index.js"
      },
      "require": {
        "types": "./dist/modal/index.d.cts",
        "default": "./dist/modal/index.cjs"
      }
    },
    "./sidebar": {
      "import": {
        "types": "./dist/sidebar/index.d.ts",
        "default": "./dist/sidebar/index.js"
      },
      "require": {
        "types": "./dist/sidebar/index.d.cts",
        "default": "./dist/sidebar/index.cjs"
      }
    },
    "./toast": {
      "import": {
        "types": "./dist/toast/index.d.ts",
        "default": "./dist/toast/index.js"
      },
      "require": {
        "types": "./dist/toast/index.d.cts",
        "default": "./dist/toast/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js playground --host 127.0.0.1",
    "release": "node ./node_modules/tsup/dist/cli-default.js && npm publish --access public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "motion": "^12.23.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "motion": "12.23.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.14"
  }
}
